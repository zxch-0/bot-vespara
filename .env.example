# --- Obligatoire -----------------------------------------------------------
# Token du bot (portail développeur Discord → Bot → Reset Token)
DISCORD_TOKEN=

# --- Fortement recommandé --------------------------------------------------
# ID du serveur Vespara : synchronise les commandes instantanément
GUILD_ID=
# ID du rôle staff qui voit et utilise les commandes de gestion
STAFF_ROLE_ID=
# Salon où sont journalisées les commandes staff (facultatif)
LOG_CHANNEL_ID=

# --- Réglages facultatifs --------------------------------------------------
# Permission que le rôle staff doit posséder pour VOIR les commandes staff.
# Valeurs : manage_guild, manage_messages, manage_roles, manage_channels,
#           manage_threads, manage_events, moderate_members, kick_members,
#           ban_members, administrator
STAFF_PERMISSION=manage_guild

# Portée des slash commands : guild (recommandé) | global | both
COMMAND_SCOPE=guild

# Fichier de sauvegarde des données (giveaways, réponses auto, configuration)
DATABASE_PATH=data/vespara.json

# Port du serveur HTTP embarqué (Render fournit sa propre valeur via PORT)
PORT=8080
# Ping automatique du service Render pour éviter la mise en veille (offre gratuite)
SELF_PING=true

# Niveau de logs : DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Personnalisation de la marque (facultatif)
BOT_NAME=Vespara
BOT_TAGLINE=Le serveur chill
